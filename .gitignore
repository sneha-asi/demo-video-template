# Build & dependency artifacts
node_modules/
.next/
__pycache__/
.venv/
.DS_Store
*.bak
*.bak2

# Rendered video output — too big for git
out/*.mp4
*.mp4

# Hyperframes-rendered transitions (regenerate via `npm run transition`).
# Keep the directory but ignore the mp4s themselves.
public/transitions/*.mp4
!public/transitions/.gitkeep

# Whisper transcripts (regenerate via `npm run transcribe`)
public/voiceover/*.json

# Licensed / extracted audio that must NOT be committed.
public/audio/music.mp3
public/voiceover/full-track.mp3
